# Copy to .env (or set in your secret manager / deployment environment).
# With NONE of these set, the sample runs in demo mode: stub token, console
# telemetry, real allowlist enforcement.

# From scripts/Register-Agent365.ps1 output:
AGENT365_CLIENT_ID=
AGENT365_TENANT_ID=
AGENT365_BLUEPRINT_ID=
AGENT365_SPONSOR_UPN=

# The agent identity's client secret. Sample-only via env; production agents
# should use a certificate or federated credential, or read the secret from
# Key Vault at runtime. Never commit a real value.
AGENT365_CLIENT_SECRET=

# Optional: OTLP endpoint for telemetry export (unset = console exporter).
OTEL_EXPORTER_OTLP_ENDPOINT=

# Optional: path to the tool allowlist (default: ../../policies/mcp-allowlist.json).
AGENT365_TOOL_POLICY=
