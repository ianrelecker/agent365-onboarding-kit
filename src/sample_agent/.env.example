# Copy to .env in this directory, or export the variables from a secret store.
# With NONE of the AGENT365_* identity variables set, the sample stays in demo
# mode: stub token, console spans, real allowlist enforcement.
#
# .env is loaded only for variables that are not already set. Do not commit it.

# From scripts/Register-Agent365.ps1. These are two different app IDs.
# The blueprint appId authenticates. The agent identity appId is fmi_path
# and the gen_ai.agent.id / ingest URL agent id.
AGENT365_TENANT_ID=
AGENT365_BLUEPRINT_CLIENT_ID=
AGENT365_AGENT_CLIENT_ID=

# Entra object id of the human accountable for this run (the sponsor for an
# autonomous run, or the signed-in user). Required outside demo mode.
# Agent 365 drops spans that omit user.id.
AGENT365_CALLER_OBJECT_ID=
AGENT365_SPONSOR_UPN=
AGENT365_AGENT_NAME=sample-agent

# Production credential: the user-assigned managed identity federated to the
# blueprint (infra/entra-agent-blueprint.bicep outputs its client id).
# Do not also set a certificate or a client secret.
AGENT365_MANAGED_IDENTITY_CLIENT_ID=

# Alternative production credential: a PEM file containing the blueprint
# certificate and its private key. The file is a secret.
# AGENT365_CLIENT_CERT_PATH=

# Development tenants only. Client secrets are not a production credential
# for an agent identity blueprint. Both lines are required together, and the
# secret is still refused unless the allow flag is true.
# AGENT365_ALLOW_CLIENT_SECRET=true
# AGENT365_CLIENT_SECRET=

# Telemetry. Unset in demo mode prints spans locally.
# Unset outside demo mode posts OTLP/HTTP+JSON to Agent 365 and fails the
# process if the response reports rejected spans.
# AGENT365_TELEMETRY_TARGET=agent365
# AGENT365_CHANNEL=web
# AGENT365_CLIENT_ADDRESS=0.0.0.0
# AGENT365_SERVER_ADDRESS=
# AGENT365_SERVER_PORT=443

# Prompt and tool-argument text is redacted outside demo mode unless this
# is true. Secrets are redacted either way. Denial reasons are always recorded.
# AGENT365_TRACE_CONTENT=false

# Optional path to the tool allowlist. Default: policies/mcp-allowlist.json.
# AGENT365_TOOL_POLICY=
